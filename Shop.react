import React, { createContext, useContext, useState, useEffect } from "react";
import {
  BrowserRouter as Router,
  Routes,
  Route,
  Link,
  useParams,
  useNavigate,
} from "react-router-dom";

const products = [
  {
    id: 1,
    name: "iPhone 15",
    category: "phones",
    price: 799,
    image: "https://via.placeholder.com/200x200/007bff/fff?text=iPhone15",
    desc: "Latest smartphone",
  },
  {
    id: 2,
    name: "Samsung Galaxy",
    category: "phones",
    price: 699,
    image: "https://via.placeholder.com/200x200/28a745/fff?text=Galaxy",
    desc: "Android flagship",
  },
  {
    id: 3,
    name: "Laptop Pro",
    category: "laptops",
    price: 1299,
    image: "https://via.placeholder.com/200x200/dc3545/fff?text=Laptop",
    desc: "High performance",
  },
  {
    id: 4,
    name: "Tablet Air",
    category: "tablets",
    price: 599,
    image: "https://via.placeholder.com/200x200/ffc107/000?text=Tablet",
    desc: "Lightweight tablet",
  },
  {
    id: 5,
    name: "Headphones",
    category: "accessories",
    price: 199,
    image: "https://via.placeholder.com/200x200/17a2b8/fff?text=Headphones",
    desc: "Wireless noise cancel",
  },
];

const CartContext = createContext();

const CartProvider = ({ children }) => {
  const [cart, setCart] = useState([]);

  useEffect(() => {
    const saved = localStorage.getItem("cart");
    if (saved) setCart(JSON.parse(saved));
  }, []);

  useEffect(() => {
    localStorage.setItem("cart", JSON.stringify(cart));
  }, [cart]);

  const addToCart = (item) => {
    setCart((prev) => {
      const exists = prev.find((p) => p.id === item.id);
      if (exists) {
        return prev.map((p) =>
          p.id === item.id ? { ...p, quantity: p.quantity + 1 } : p
        );
      }
      return [...prev, { ...item, quantity: 1 }];
    });
  };

  const removeFromCart = (id) => {
    setCart((prev) => prev.filter((p) => p.id !== id));
  };

  const updateQuantity = (id, qty) => {
    if (qty <= 0) return removeFromCart(id);
    setCart((prev) =>
      prev.map((p) => (p.id === id ? { ...p, quantity: qty } : p))
    );
  };

  const getTotal = () => cart.reduce((sum, p) => sum + p.price * p.quantity, 0);

  return (
    <CartContext.Provider
      value={{ cart, addToCart, removeFromCart, updateQuantity, getTotal }}
    >
      {children}
    </CartContext.Provider>
  );
};

const ProductList = () => {
  const [filter, setFilter] = useState({
    category: "",
    minPrice: 0,
    maxPrice: 2000,
    search: "",
  });
  const [filteredProducts, setFilteredProducts] = useState(products);
  const { addToCart } = useContext(CartContext);
  const navigate = useNavigate();

  useEffect(() => {
    let res = products.filter((p) => {
      const matchesCat = !filter.category || p.category === filter.category;
      const matchesPrice =
        p.price >= filter.minPrice && p.price <= filter.maxPrice;
      const matchesSearch = p.name
        .toLowerCase()
        .includes(filter.search.toLowerCase());
      return matchesCat && matchesPrice && matchesSearch;
    });
    setFilteredProducts(res);
  }, [filter]);

  return (
    <div className="p-8 max-w-6xl mx-auto">
      <div className="flex justify-between items-center mb-8">
        <h1 className="text-3xl font-bold">Products</h1>
        <Link
          to="/cart"
          className="bg-blue-500 text-white px-4 py-2 rounded hover:bg-blue-600"
        >
          Cart ({useContext(CartContext).cart.length})
        </Link>
      </div>

      <div className="grid md:grid-cols-3 gap-6 mb-8">
        <div className="bg-white p-6 rounded-lg shadow">
          <h3 className="font-semibold mb-4">Filters</h3>
          <select
            value={filter.category}
            onChange={(e) => setFilter({ ...filter, category: e.target.value })}
            className="w-full p-2 border rounded mb-4"
          >
            <option value="">All Categories</option>
            <option value="phones">Phones</option>
            <option value="laptops">Laptops</option>
            <option value="tablets">Tablets</option>
            <option value="accessories">Accessories</option>
          </select>
          <input
            type="number"
            placeholder="Min Price"
            value={filter.minPrice}
            onChange={(e) =>
              setFilter({ ...filter, minPrice: +e.target.value })
            }
            className="w-full p-2 border rounded mb-4"
          />
          <input
            type="number"
            placeholder="Max Price"
            value={filter.maxPrice}
            onChange={(e) =>
              setFilter({ ...filter, maxPrice: +e.target.value })
            }
            className="w-full p-2 border rounded mb-4"
          />
          <input
            type="text"
            placeholder="Search..."
            value={filter.search}
            onChange={(e) => setFilter({ ...filter, search: e.target.value })}
            className="w-full p-2 border rounded"
          />
        </div>

        <div className="md:col-span-2">
          <div className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {filteredProducts.map((product) => (
              <div
                key={product.id}
                className="bg-white border rounded-lg shadow hover:shadow-lg p-4"
              >
                <img
                  src={product.image}
                  alt={product.name}
                  className="w-full h-48 object-cover rounded mb-4"
                />
                <h3 className="font-bold text-xl mb-2">{product.name}</h3>
                <p className="text-gray-600 mb-4">${product.price}</p>
                <div className="flex gap-2">
                  <button
                    onClick={() => addToCart(product)}
                    className="flex-1 bg-green-500 text-white py-2 px-4 rounded hover:bg-green-600"
                  >
                    Add to Cart
                  </button>
                  <button
                    onClick={() => navigate("/product/${product.id}")}
                    className="flex-1 bg-blue-500 text-white py-2 px-4 rounded hover:bg-blue-600"
                  >
                    View
                  </button>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  );
};

const ProductDetail = () => {
  const { id } = useParams();
  const product = products.find((p) => p.id === parseInt(id));
  const { addToCart } = useContext(CartContext);
  const navigate = useNavigate();

  if (!product) return <div className="p-8 text-center">Product not found</div>;

  return (
    <div className="p-8 max-w-4xl mx-auto">
      <button
        onClick={() => navigate(-1)}
        className="mb-8 text-blue-500 hover:underline"
      >
        &larr; Back
      </button>
      <div className="grid md:grid-cols-2 gap-8">
        <img
          src={product.image}
          alt={product.name}
          className="w-full h-96 object-cover rounded-lg"
        />
        <div>
          <h1 className="text-4xl font-bold mb-4">{product.name}</h1>
          <p className="text-3xl text-green-600 mb-6">${product.price}</p>
          <p className="text-lg mb-8">{product.desc}</p>
          <p className="text-gray-600 mb-8">Category: {product.category}</p>
          <button
            onClick={() => addToCart(product)}
            className="w-full bg-green-500 text-white py-4 px-8 rounded-lg text-xl hover:bg-green-600"
          >
            Add to Cart
          </button>
        </div>
      </div>
    </div>
  );
};

const Cart = () => {
  const { cart, removeFromCart, updateQuantity, getTotal } =
    useContext(CartContext);
  const navigate = useNavigate();

  return (
    <div className="p-8 max-w-4xl mx-auto">
      <div className="flex justify-between items-center mb-8">
        <h1 className="text-3xl font-bold">Shopping Cart</h1>
        <Link to="/" className="text-blue-500 hover:underline">
          Continue Shopping →
        </Link>
      </div>
      {cart.length === 0 ? (
        <div className="text-center py-12">
          <p className="text-xl mb-4">Your cart is empty</p>
          <Link
            to="/"
            className="bg-blue-500 text-white px-6 py-3 rounded hover:bg-blue-600"
          >
            Go to Shop
          </Link>
        </div>
      ) : (
        <>
          <div className="space-y-4 mb-8">
            {cart.map((item) => (
              <div
                key={item.id}
                className="flex items-center justify-between bg-white p-6 rounded-lg shadow"
              >
                <img
                  src={item.image}
                  alt={item.name}
                  className="w-24 h-24 object-cover rounded"
                />
                <div className="flex-1 ml-4">
                  <h3 className="font-bold text-xl">{item.name}</h3>
                  <p className="text-gray-600">${item.price}</p>
                </div>
                <div className="flex items-center gap-4">
                  <button
                    onClick={() => updateQuantity(item.id, item.quantity - 1)}
                    className="w-10 h-10 bg-gray-200 rounded-full hover:bg-gray-300"
                  >
                    -
                  </button>
                  <span className="font-bold text-xl">{item.quantity}</span>
                  <button
                    onClick={() => updateQuantity(item.id, item.quantity + 1)}
                    className="w-10 h-10 bg-gray-200 rounded-full hover:bg-gray-300"
                  >
                    +
                  </button>
                  <button
                    onClick={() => removeFromCart(item.id)}
                    className="ml-4 bg-red-500 text-white px-4 py-2 rounded hover:bg-red-600"
                  >
                    Remove
                  </button>
                </div>
              </div>
            ))}
          </div>
          <div className="bg-white p-6 rounded-lg shadow">
            <h2 className="text-2xl font-bold mb-4">
              Total: ${getTotal().toFixed(2)}
            </h2>
            <button className="w-full bg-green-500 text-white py-4 text-xl rounded-lg hover:bg-green-600">
              Checkout
            </button>
          </div>
        </>
      )}
    </div>
  );
};

function App() {
  return (
    <Router>
      <div className="min-h-screen bg-gray-100">
        <nav className="bg-white shadow-lg p-4">
          <div className="max-w-6xl mx-auto flex justify-between items-center">
            <Link to="/" className="text-2xl font-bold text-gray-800">
              Shop
            </Link>
            <div className="space-x-4">
              <Link to="/" className="text-gray-600 hover:text-gray-900">
                Home
              </Link>
              <Link to="/cart" className="text-gray-600 hover:text-gray-900">
                Cart
              </Link>
            </div>
          </div>
        </nav>
        <Routes>
          <Route path="/" element={<ProductList />} />
          <Route path="/product/:id" element={<ProductDetail />} />
          <Route path="/cart" element={<Cart />} />
        </Routes>
      </div>
    </Router>
  );
}

export default function Root() {
  return (
    <CartProvider>
      <App />
    </CartProvider>
  );
}
